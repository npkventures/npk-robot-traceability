{
  "description": "Stop hook continuation after Codex confirms goal completion in the current turn.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(create_goal|get_goal|update_goal)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex-goal-stop.py\"",
            "timeout": 5,
            "statusMessage": "Checking confirmed goal completion"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/codex-goal-stop.py\"",
            "timeout": 5,
            "statusMessage": "Checking confirmed goal completion"
          }
        ]
      }
    ]
  }
}
